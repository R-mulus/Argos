# Configuração API HTTP: copie para backend/.env e adicione sua chave pública.
PORT=3333
CORS_ORIGIN=http://localhost:5173
SUPABASE_URL=https://pqmdqtcjemgnjtugtuqy.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Configuração do worker MQTT (mesmo .env ou arquivo de ambiente separado).
# Execute worker apenas em processo de servidor; nunca inclua estes valores no Vite/frontend.
SUPABASE_SECRET_KEY=
MQTT_URL=mqtts://broker.exemplo.com:8883
MQTT_CLIENT_ID=argos-ingest-01
MQTT_USERNAME=
MQTT_PASSWORD=

# Somente para broker local sem TLS, em localhost/127.0.0.1:
# MQTT_URL=mqtt://127.0.0.1:1883
# MQTT_ALLOW_INSECURE_LOCAL=true
