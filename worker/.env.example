MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=argos-worker
MQTT_PASSWORD=
MQTT_CLIENT_ID=argos-ingestion-v1
# mqtts:// exige certificado válido. Deixe vazio para usar CAs do sistema.
MQTT_CA_FILE=
MQTT_SESSION_EXPIRY_SECONDS=604800
SUPABASE_URL=
# Secret key sb_secret_... ou service_role legado. Nunca usar anon/publishable.
SUPABASE_SECRET_KEY=
QUEUE_PATH=./data/ingestion.sqlite
QUEUE_MAX_ITEMS=100000
DEAD_MAX_ITEMS=10000
BATCH_SIZE=32
POLL_INTERVAL_MS=250
REQUEST_TIMEOUT_MS=10000
DEVICE_CACHE_MS=10000
RETRY_BASE_MS=1000
RETRY_MAX_MS=60000
