#pragma once
// Compartilhado com TODOS os transmissores e receptores da propriedade.
#define ARGOS_BEACON_SECRET "SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_DE_32_OU_MAIS_CARACTERES"
// MESMAS configuracoes de rede para todos os receptores.
#define ARGOS_WIFI_SSID "SEU_WIFI_2_4GHZ"
#define ARGOS_WIFI_PASS "SENHA_DO_WIFI"
// IP LAN da maquina rodando EMQX; NAO e 127.0.0.1 nem a porta do painel 18083.
#define ARGOS_MQTT_HOST "SEU_ENDPOINT_EMQX"
// Conta MQTT do receptor criada no EMQX (nao a conta admin do painel).
// Obrigatorios também em laboratório; não usar a conta administrativa.
#define ARGOS_MQTT_USER ""
#define ARGOS_MQTT_PASS ""
// Necessario somente se ARGOS_LOCAL_PLAINTEXT=0 (TLS).
// Baixe a CA no painel EMQX. Cole o PEM completo, sem desativar a validacao TLS.
#define ARGOS_MQTT_CA R"PEM(
-----BEGIN CERTIFICATE-----
SUBSTITUA_PELO_CERTIFICADO_CA_DO_BROKER
-----END CERTIFICATE-----
)PEM"
